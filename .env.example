# =============================================================================
# ONB-Social — variables d'environnement
# Copier en `.env` et adapter. Ne jamais commiter `.env`.
# En production (App Service), définir ces variables dans les « App settings ».
# =============================================================================

# ── Serveur API ──────────────────────────────────────────────────────────────
# `npm start` force NODE_ENV=production ; en local, utiliser `npm run dev`.
PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info

# ── Base de données (PostgreSQL 16.15 — Azure Database for PostgreSQL) ────
# Connexion de l'API : TOUJOURS le rôle applicatif (API_DB_USER), jamais l'admin.
DATABASE_URL=postgres://onb_api:change-me-api@localhost:5432/onb_social
# true pour imposer TLS (obligatoire sur Azure)
DATABASE_SSL=false
# DATABASE_POOL_MAX=10

# ── Migration (`npm run db:migrate`, lancé depuis un poste ou la CI) ─────────
# Connexion propriétaire (compte admin du serveur). Jamais utilisée par l'API.
DATABASE_ADMIN_URL=postgres://postgres:change-me@localhost:5432/onb_social
# Rôle applicatif créé/mis à jour par db:migrate (= utilisateur de DATABASE_URL)
API_DB_USER=onb_api
API_DB_PASSWORD=change-me-api
# Rôle de la Function timer (optionnel) : peut seulement exécuter
# expire_lapsed_subscriptions(). Sa chaîne de connexion va dans la Function App.
# JOBS_DB_USER=onb_jobs
# JOBS_DB_PASSWORD=change-me-jobs

# ── Authentification (validation JWT générique) ──────────────────────────────
# Mode dev : fournisseur local intégré à l'API (voir DEV_AUTH_*).
# Entra ID plus tard, par exemple :
#   AUTH_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#   AUTH_AUDIENCE=<client-id-de-l-api>   (ou api://<client-id>)
#   AUTH_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
AUTH_ISSUER=http://localhost:3000/api/dev-auth
AUTH_AUDIENCE=onb-social-api
AUTH_JWKS_URL=http://localhost:3000/api/dev-auth/jwks.json
# Claim contenant l'identifiant utilisateur (GUID) → profiles.id
AUTH_USER_ID_CLAIM=oid
# AUTH_CLOCK_TOLERANCE=60

# ── Fournisseur d'auth DEV (jamais en production : `npm start` refuse de démarrer) ─
DEV_AUTH_ENABLED=true
# Clé de signature générée au premier démarrage (fichier ignoré par git)
# DEV_AUTH_KEY_FILE=api/.dev-auth/signing-key.json
# DEV_AUTH_TOKEN_TTL=43200

# ── Fichiers ─────────────────────────────────────────────────────────────────
# Front buildé servi par l'API (fallback SPA vers index.html)
# STATIC_DIR=dist
# Dossier des médias uploadés (prod : /home/data/media)
MEDIA_DIR=data/media

# ── Front (Vite) — seules les variables VITE_* sont exposées au navigateur ──
# Fournisseur d'auth : dev (formulaire nom d'utilisateur) | msal (Entra ID, à implémenter)
VITE_AUTH_PROVIDER=dev
# Base de l'API vue du navigateur (même origine par défaut)
# VITE_API_BASE_URL=/api
# Claim identifiant utilisateur dans le token (doit correspondre à AUTH_USER_ID_CLAIM)
# VITE_AUTH_USER_ID_CLAIM=oid
# Cible du proxy /api du serveur de dev Vite
# VITE_API_PROXY_TARGET=http://localhost:3000

# MSAL (quand VITE_AUTH_PROVIDER=msal — voir src/lib/auth/msalProvider.js)
# VITE_MSAL_TENANT_ID=
# VITE_MSAL_CLIENT_ID=
# VITE_MSAL_API_SCOPE=api://<client-id-api>/access_as_user
# VITE_MSAL_REDIRECT_URI=http://localhost:5173/auth/callback
