# =============================================================================
# ONB-Social — variables d'environnement
# Copier en `.env` et adapter. Ne jamais commiter `.env`.
# =============================================================================

# ── Base de données ──────────────────────────────────────────────────────────
# Connexion administrateur : sert uniquement à initialiser la base
# (schéma, seed, création du rôle de l'API).
DATABASE_ADMIN_URL=postgres://postgres:change-me@localhost:5432/onb_social

# Rôle de connexion de l'API (non-superuser, créé à l'initialisation).
API_DB_USER=onb_api
API_DB_PASSWORD=change-me-api
