{
  "name": "onb-social",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --watch-path=api/src api/src/server.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node api/src/server.js --production",
    "db:migrate": "node api/scripts/db-migrate.js",
    "db:make-admin": "node api/scripts/make-admin.js"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.30.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "pinia": "^2.2.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.0",
    "concurrently": "^10.0.6",
    "pino-pretty": "^13.2.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
